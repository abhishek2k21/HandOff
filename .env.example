# PostgreSQL (used by docker-compose and Spring Boot)
POSTGRES_USER=handoff
POSTGRES_PASSWORD=handoff
POSTGRES_DB=handoff

# Spring Boot datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/handoff
SPRING_DATASOURCE_USERNAME=handoff
SPRING_DATASOURCE_PASSWORD=handoff

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
